alias install : install-lib ;
explicit install ;

install install-lib : qft++
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project :
	requirements
	<include>./topincludes 
	;

lib qft++ : 
	[ glob relativistic-quantum-mechanics/*.cc 
	  tensor/*.cc 
          matrix/*.cc : ] 
	: : : ;
