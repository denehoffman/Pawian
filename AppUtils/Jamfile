alias install : install-lib ;
explicit install ;

install install-lib : AppUtils
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;
project : 
	;

lib AppUtils : 
	[ glob *.cc : *App.cc ] 
	$(TOP)/Utils//Utils 
	$(TOP)/qft++//qft++
	$(TOP)/ErrLogger//ErrLogger
	$(TOP)/ConfigParser//ConfigParser
	$(TOP)/FitParams//FitParams
	$(TOP)/Event//Event
	$(TOP)/PwaDynamics//PwaDynamics
	$(TOP)/PspGen//PspGen
	$(TOP)/PwaUtils//PwaUtils
	$(TOP)/MinFunctions//MinFunctions
	$(TOP)/pbarpUtils//pbarpUtils
	$(TOP)/epemUtils//epemUtils
	$(TOP)/resUtils//resUtils
	$(TOP)/gamgamUtils//gamgamUtils
	$(TOP)/pipiScatteringUtils//pipiScatteringUtils
	:
	: 
	: ;
