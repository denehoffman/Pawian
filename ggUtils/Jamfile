alias install : install-lib ;
explicit install ;

install install-lib : ggUtils
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project : 
	;

lib ggUtils : 
	[ glob *.cc : *App.cc ] 
	$(TOP)/ConfigParser//ConfigParser
	$(TOP)/ErrLogger//ErrLogger
	$(TOP)/Particle//Particle
	$(TOP)/PwaUtils//PwaUtils
	$(TOP)/Utils//Utils
	$(TOP)/qft++//qft++
	$(TOP)/qft++Extension//qft++Extension
	: ;

exe ggStatesApp : ggStatesApp.cc ggUtils 
	$(TOP)/ConfigParser//ConfigParser
	$(TOP)/FitParams//FitParams
	$(TOP)/PwaUtils//PwaUtils 
	$(TOP)/Utils//Utils
	$(TOP)/Event//Event
	$(TOP)/pbarpUtils//pbarpUtils 
	$(TOP)/qft++//qft++
	$(TOP)/ErrLogger//ErrLogger
    	: ;
