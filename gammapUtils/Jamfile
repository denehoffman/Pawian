alias install : install-bin install-lib ;
explicit install ;

install install-bin : gammapStatesApp
                 : <location>$(TOP)/bin
                   <install-dependencies>on 
                   <install-type>EXE
                   ;

install install-lib : gammapUtils
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project : 
	;

lib gammapUtils : 
	[ glob *.cc : *App.cc ] 
	$(TOP)/Utils//Utils 
	$(TOP)/qft++//qft++
	$(TOP)/ErrLogger//ErrLogger
	$(TOP)/ConfigParser//ConfigParser
	$(TOP)/PwaUtils//PwaUtils 
	:
	: 
	: ;

exe gammapStatesApp : gammapStatesApp.cc gammapUtils
	$(TOP)/ErrLogger//ErrLogger
	$(TOP)/PwaUtils//PwaUtils
	$(TOP)/Utils//Utils
	$(TOP)/qft++//qft++
	: ;

unit-test test_ReflectivityBasis
  : test/TestReflectivityBasis.cc
    $(TOP)//boost_test
    gammapUtils
  ;
