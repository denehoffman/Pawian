#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(cd "$script_dir/.." && pwd)"
jamroot="$repo/Jamroot"
nix_target="nix/Jamroot.nix"
original_target=""

if [[ -L "$jamroot" ]]; then
  original_target="$(readlink "$jamroot")"
elif [[ -e "$jamroot" ]]; then
  echo "Refusing to replace the existing non-symlink Jamroot." >&2
  exit 1
fi

restore_jamroot() {
  if [[ -L "$jamroot" && "$(readlink "$jamroot")" == "$nix_target" ]]; then
    rm -f "$jamroot"
  fi

  if [[ -n "$original_target" && ! -e "$jamroot" && ! -L "$jamroot" ]]; then
    ln -s "$original_target" "$jamroot"
  fi
}

trap restore_jamroot EXIT INT TERM

if [[ -L "$jamroot" ]]; then
  rm -f "$jamroot"
fi
ln -s "$nix_target" "$jamroot"

cd "$repo"
"$@"
