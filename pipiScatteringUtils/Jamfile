alias install : install-bin install-lib ;
explicit install ;

install install-bin : FVectorGeneralApp
	         : <location>$(TOP)/bin
                   <install-dependencies>on 
                   <install-type>EXE
                   ;


install install-lib : pipiScatteringUtils
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project : 
	;

lib pipiScatteringUtils : 
	[ glob *.cc : *App.cc ] 
	$(TOP)/Utils//Utils 
	$(TOP)/qft++//qft++
	$(TOP)/ErrLogger//ErrLogger
	$(TOP)/ConfigParser//ConfigParser
	$(TOP)/Event//Event
	$(TOP)/PwaUtils//PwaUtils
	$(TOP)/Particle//Particle
	: 
	: 
	: ;

exe FVectorGeneralApp : FVectorGeneralApp.cc pipiScatteringUtils
          $(TOP)/PwaDynamics//PwaDynamics
          $(TOP)/Particle//Particle
          $(TOP)/ConfigParser//ConfigParser
          $(TOP)/PwaUtils//PwaUtils
          $(TOP)/FitParams//FitParams
          $(TOP)/Event//Event
          $(TOP)/qft++Extension//qft++Extension
          $(TOP)/ErrLogger//ErrLogger
          $(TOP)/qft++//qft++
          $(TOP)/Utils//Utils
          : ;
