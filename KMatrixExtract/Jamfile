alias install : install-bin install-lib ;
explicit install ;

install install-bin : TMatrixErrorExtrApp TMatrixResidueExtrApp ArgandModuloConverterApp TMatrixGeneralApp TMatrixPiPiSWaveSimple4piPhpApp
                 : <location>$(TOP)/bin
                   <install-dependencies>on 
                   <install-type>EXE
                   ;

install install-lib : KMatrixExtract
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project : 
        ;

lib KMatrixExtract : 
        [ glob *.cc : *App.cc ]
	: <use>$(TOP)//Minuit2  
	: 
	: <library>$(TOP)//Minuit2  ;

exe TMatrixErrorExtrApp : TMatrixErrorExtrApp.cc KMatrixExtract
        $(TOP)/pipiScatteringUtils//pipiScatteringUtils
	$(TOP)/PwaDynamics//PwaDynamics
	$(TOP)/ConfigParser//ConfigParser
	$(TOP)/PwaUtils//PwaUtils
	$(TOP)/FitParams//FitParams
	$(TOP)/Particle//Particle
	$(TOP)/qft++Extension//qft++Extension
        $(TOP)/qft++//qft++
        $(TOP)/ErrLogger//ErrLogger
	: ;

exe TMatrixResidueExtrApp : TMatrixResidueExtrApp.cc KMatrixExtract
        $(TOP)/pipiScatteringUtils//pipiScatteringUtils
	$(TOP)/PwaDynamics//PwaDynamics
	$(TOP)/ConfigParser//ConfigParser
	$(TOP)/PwaUtils//PwaUtils
	$(TOP)/FitParams//FitParams
	$(TOP)/Particle//Particle
	$(TOP)/qft++Extension//qft++Extension
        $(TOP)/qft++//qft++
        $(TOP)/ErrLogger//ErrLogger
	: ;

exe ArgandModuloConverterApp : ArgandModuloConverterApp.cc KMatrixExtract
        $(TOP)/pipiScatteringUtils//pipiScatteringUtils
	$(TOP)/PwaDynamics//PwaDynamics
	$(TOP)/ConfigParser//ConfigParser
	$(TOP)/PwaUtils//PwaUtils
	$(TOP)/FitParams//FitParams
	$(TOP)/Particle//Particle
	$(TOP)/qft++Extension//qft++Extension
        $(TOP)/qft++//qft++
        $(TOP)/ErrLogger//ErrLogger
	: ;

exe TMatrixGeneralApp : TMatrixGeneralApp.cc KMatrixExtract
          $(TOP)/pipiScatteringUtils//pipiScatteringUtils
          $(TOP)/PwaDynamics//PwaDynamics
          $(TOP)/Particle//Particle
          $(TOP)/ConfigParser//ConfigParser
          $(TOP)/PwaUtils//PwaUtils
          $(TOP)/FitParams//FitParams
          $(TOP)/Event//Event
          $(TOP)/qft++Extension//qft++Extension
          $(TOP)/ErrLogger//ErrLogger
          $(TOP)/qft++//qft++
          $(TOP)/Utils//Utils
          : ;


exe TMatrixPiPiSWaveSimple4piPhpApp : TMatrixPiPiSWaveSimple4piPhpApp.cc KMatrixExtract
          $(TOP)/pipiScatteringUtils//pipiScatteringUtils
          $(TOP)/PwaDynamics//PwaDynamics
          $(TOP)/Particle//Particle
          $(TOP)/ConfigParser//ConfigParser
          $(TOP)/PwaUtils//PwaUtils
          $(TOP)/FitParams//FitParams
          $(TOP)/Event//Event
          $(TOP)/qft++Extension//qft++Extension
          $(TOP)/ErrLogger//ErrLogger
          $(TOP)/qft++//qft++
          $(TOP)/Utils//Utils
          : ;
