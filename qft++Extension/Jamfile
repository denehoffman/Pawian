alias install : install-lib ;
explicit install ;

install install-bin : OmnesMatrixGeneralApp
                 : <location>$(TOP)/bin
                   <install-dependencies>on 
                   <install-type>EXE
                   ;

install install-lib : qft++Extension
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;
project : 
	;

lib qft++Extension : 
	[ glob *.cc : *App.cc ] 
	$(TOP)/qft++//qft++
	$(TOP)/ErrLogger//ErrLogger
	:
	: 
	: ;

exe OmnesMatrixGeneralApp : OmnesMatrixGeneralApp.cc qft++Extension
        $(TOP)/ConfigParser//ConfigParser
        $(TOP)/Particle//Particle
        $(TOP)/qft++Extension//qft++Extension
        $(TOP)/qft++//qft++
        $(TOP)/ErrLogger//ErrLogger
        : ;