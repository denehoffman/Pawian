#!/usr/bin/perl -w
my $queue="bsub -l nodes=1:ppn=4 -q pwa";
#my $queue="bsub -q pwaLarge";
print $queue."\n";
for ($i=1;$i<=15;$i++)
{
    my $client="Client$i";
    print $client."\n";
    my $submit="$queue -o batch$client.out \"../../pbarpReactionApp -c pbarpReactionDefault.cfg --mode client >&! log.$client\"";
    print $submit."\n";
    system($submit); 
}
