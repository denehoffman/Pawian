alias install : install-lib ;
explicit install ;

install install-bin : StreamerTestApp PwaCovMatrixApp ChangeCovMatrixApp CreateCovMatrixApp
                 : <location>$(TOP)/bin
                   <install-dependencies>on 
                   <install-type>EXE
                   ;

install install-lib : FitParams
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project : 
	;

lib FitParams : 
	[ glob *.cc : *App.cc ] 
	: <use>$(TOP)//Minuit2
	: 
	: <library>$(TOP)//Minuit2 ;

exe StreamerTestApp : StreamerTestApp.cc FitParams $(TOP)/qft++//qft++ 
	$(TOP)/ConfigParser//ConfigParser
        $(TOP)/qft++Extension//qft++Extension
        $(TOP)/qft++//qft++
	$(TOP)/ErrLogger//ErrLogger
	: ;

exe PwaCovMatrixApp : PwaCovMatrixApp.cc FitParams 
	$(TOP)/ConfigParser//ConfigParser
        $(TOP)/qft++Extension//qft++Extension
        $(TOP)/qft++//qft++
	$(TOP)/ErrLogger//ErrLogger
	: ;

exe ChangeCovMatrixApp : ChangeCovMatrixApp.cc FitParams
        $(TOP)/ConfigParser//ConfigParser
        $(TOP)/qft++Extension//qft++Extension
        $(TOP)/qft++//qft++
        $(TOP)/ErrLogger//ErrLogger
        : ;

exe CreateCovMatrixApp : CreateCovMatrixApp.cc FitParams
        $(TOP)/ConfigParser//ConfigParser
        $(TOP)/qft++Extension//qft++Extension
        $(TOP)/qft++//qft++
        $(TOP)/ErrLogger//ErrLogger
        : ;