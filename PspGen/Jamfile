alias install : install-bin install-lib ;
explicit install ;

install install-bin : PspGenTestApp
                 : <location>$(TOP)/bin
                   <install-dependencies>on 
                   <install-type>EXE
                   ;

install install-lib : PspGen
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project : 
	;

lib PspGen : 
	[ glob *.cc : *App.cc ] 
	$(TOP)/ErrLogger//ErrLogger 
	: 
	: 
	: ;

exe PspGenTestApp : PspGenTestApp.cc PspGen : ;

