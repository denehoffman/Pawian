import os ;
import testing ;

path-constant TOP : . ;

local ROOT_INCLUDE = [ os.environ PAWIAN_ROOT_INCLUDE ] ;
local BOOST_INCLUDE = [ os.environ PAWIAN_BOOST_INCLUDE ] ;
local BOOST_LIBRARY = [ os.environ PAWIAN_BOOST_LIBRARY ] ;
local MINUIT2_INCLUDE = [ os.environ PAWIAN_MINUIT2_INCLUDE ] ;
local MINUIT2_LIBRARY_FILE = [ os.environ PAWIAN_MINUIT2_LIBRARY ] ;
local GSL_INCLUDE = [ os.environ PAWIAN_GSL_INCLUDE ] ;
local GSL_LIBRARY = [ os.environ PAWIAN_GSL_LIBRARY ] ;
local LOG4CPP_INCLUDE = [ os.environ PAWIAN_LOG4CPP_INCLUDE ] ;
local LOG4CPP_LIBRARY = [ os.environ PAWIAN_LOG4CPP_LIBRARY ] ;
local root-libraries = [ SHELL "root-config --libs" ] ;
ROOTLIBS = [ MATCH "(.*)[\n]" : $(root-libraries) ] ;

BOOSTLIBS =
  -lboost_chrono
  -lboost_date_time
  -lboost_filesystem
  -lboost_program_options
  -lboost_regex
  -lboost_serialization
  -lboost_system
  -lboost_timer
  -lboost_unit_test_framework
  ;

lib boost_test : : <name>boost_unit_test_framework <search>$(BOOST_LIBRARY) ;
alias Minuit2 ;

project :
  requirements <include>./
  <include>$(TOP)
  <include>$(ROOT_INCLUDE)
  <include>$(BOOST_INCLUDE)
  <include>$(MINUIT2_INCLUDE)
  <include>$(GSL_INCLUDE)
  <include>$(LOG4CPP_INCLUDE)
  <cxxflags>-std=c++17
  <cxxflags>-D_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION
  <cxxflags>-ftemplate-depth=256
  <cxxflags>-DBOOST_BIND_GLOBAL_PLACEHOLDERS
  <link>shared
  <linkflags>-L$(TOP)/lib
  <linkflags>$(MINUIT2_LIBRARY_FILE)
  <linkflags>$(ROOTLIBS)
  <linkflags>-L$(BOOST_LIBRARY)
  <linkflags>$(BOOSTLIBS)
  <linkflags>-L$(GSL_LIBRARY)
  <linkflags>-lgsl
  <linkflags>-lgslcblas
  <linkflags>-L$(LOG4CPP_LIBRARY)
  <linkflags>-llog4cpp
  <cxxflags>-fPIC
  <cxxflags>-Wall
  ;

build-project ErrLogger ;
build-project qft++ ;
build-project qft++Extension ;
build-project ConfigParser ;
build-project Particle ;
build-project Utils ;
build-project Event ;
build-project FitParams ;
build-project PwaDynamics ;
build-project PwaUtils ;
build-project MinFunctions ;
build-project AppUtils ;
build-project pbarpUtils ;
build-project epemUtils ;
build-project resUtils ;
build-project ggUtils ;
build-project gammapUtils ;
build-project pipiScatteringUtils ;
build-project gslUtils ;
build-project qaErrorExtract ;
build-project PspGen ;
build-project Examples ;
build-project KMatrixExtract ;
build-project PwaApps ;

alias gammap-install : Examples/gammap//install ;
