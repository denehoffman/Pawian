alias install : install-bin install-lib ;
explicit install ;

install install-bin : pbarpStatesApp pbarpTensorAmpApp
                 : <location>$(TOP)/bin
                   <install-dependencies>on 
                   <install-type>EXE
                   ;

install install-lib : pbarp
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project : 
        ;

lib pbarp : 
        [ glob *.cc : *App.cc ]  
        :  
        : 
        :   ;

exe pbarpStatesApp : pbarpStatesApp.cc pbarp 
        	     $(TOP)/Event//Event
        	     $(TOP)/ConfigParser//ConfigParser
		     $(TOP)/FitParams//FitParams
        	     $(TOP)/PwaUtils//PwaUtils
		     $(TOP)/AppUtils//AppUtils
        	     $(TOP)/pbarpUtils//pbarpUtils
        	     $(TOP)/Particle//Particle
        	     $(TOP)/qft++//qft++ 
        	     $(TOP)/ErrLogger//ErrLogger
    		   : ;


exe pbarpTensorAmpApp : pbarpTensorAmpApp.cc pbarp 
        	      	$(TOP)/Event//Event
			$(TOP)/ConfigParser//ConfigParser
		     	$(TOP)/FitParams//FitParams
        	     	$(TOP)/PwaUtils//PwaUtils
		     	$(TOP)/AppUtils//AppUtils
        	     	$(TOP)/pbarpUtils//pbarpUtils
        	     	$(TOP)/Particle//Particle
        	     	$(TOP)/qft++//qft++ 
        	     	$(TOP)/ErrLogger//ErrLogger
    		      : ;
