#!/bin/sh

echo "Starting qa for channel pbar p -> eta eta pi0 ..."
$TOP_DIR/bin/singleChannelApp --pbarpFiles pbarpToEtaEtaPiReaction.cfg --paramFile ./finalResult.dat --mode qaModeSimple

sleep 5

echo "Starting qa for channel pbar p -> K+ K- pi0 ..."
$TOP_DIR/bin/singleChannelApp --pbarpFiles pbarpToKKPiReaction.cfg --paramFile ./finalResult.dat --mode qaModeSimple

sleep 5

echo "Starting qa for channel e+ e- -> J/psi -> chi_c1 gamma -> (K+ K- pi0) gamma ..."
$TOP_DIR/bin/singleChannelApp --epemFiles psiToGamKKpi.cfg --paramFile ./finalResult.dat --mode qaModeSimple

sleep 5

echo "Starting first client for D0 -> K- pi+ pi0 ..."
$TOP_DIR/bin/singleChannelApp --resFiles D0ToKmpippi0.cfg --paramFile ./finalResult.dat --mode qaModeSimple

echo done
