#!/bin/sh

echo Starting evoserver ...

$TOP_DIR/bin/singleChannelApp --pbarpFiles pbarpReactionDefault.cfg --mode evoserver --paramFile defaultparams.dat !>& evoserver.log &

sleep 5

echo Starting clients ...

$TOP_DIR/bin/singleChannelApp --pbarpFiles pbarpReactionDefault.cfg --mode client --paramFile defaultparams.dat !>& evoclient1.log &

$TOP_DIR/bin/singleChannelApp --pbarpFiles pbarpReactionDefault.cfg --mode client --paramFile defaultparams.dat !>& evoclient2.log &

echo done
