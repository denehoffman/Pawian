set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

here := justfile_directory()
repo := here / "../../.."
generated := here / "generated"
timings := generated / "timings"
python := env_var_or_default("COMPARISON_PYTHON", env_var_or_default("NIX_PYTHON", generated / "python/bin/python"))
bootstrap_python := env_var_or_default("PYTHON", "python3")
data_events := env_var_or_default("DATA_EVENTS", "10000")
mc_events := env_var_or_default("MC_EVENTS", "100000")
jobs := env_var_or_default("JOBS", num_cpus())

default:
    @just --justfile {{ quote(here / "Justfile") }} --list

# Prepare an isolated Python environment, or validate the one supplied by Nix.
setup:
    mkdir -p {{ quote(generated) }}
    if [[ {{ quote(python) }} == {{ quote(generated / "python/bin/python") }} && ! -x {{ quote(python) }} ]]; then \
      {{ quote(bootstrap_python) }} -m venv {{ quote(generated / "python") }}; \
    fi
    if {{ quote(python) }} -c 'import laddu, matplotlib, numpy, pyarrow, uproot' 2>/dev/null; then \
      exit 0; \
    elif [[ {{ quote(python) }} == {{ quote(generated / "python/bin/python") }} ]]; then \
      {{ quote(python) }} -m pip install -r {{ quote(here / "requirements.txt") }}; \
    else \
      echo 'COMPARISON_PYTHON is missing packages from requirements.txt' >&2; \
      exit 2; \
    fi

# Generate the one common pseudo-data and weighted normalization sample.
generate: setup
    cd {{ quote(here) }} && {{ quote(python) }} generate.py \
      --output {{ quote(generated) }} \
      --data-events {{ quote(data_events) }} \
      --mc-events {{ quote(mc_events) }}

# Write PAWIAN ASCII and one AmpTools ROOT tree per mass bin.
translate: generate
    cd {{ quote(here) }} && {{ quote(python) }} translate.py --output {{ quote(generated) }}

# Fit independent mass bins in parallel with one Laddu thread per process.
laddu: generate
    {{ quote(python) }} {{ quote(here / "benchmark.py") }} run \
      --name Laddu \
      --output {{ quote(timings / "laddu.json") }} \
      --log {{ quote(timings / "laddu.log") }} \
      --cwd {{ quote(here) }} -- \
      {{ quote(python) }} fit_laddu.py \
        --output {{ quote(generated / "laddu-fit.json") }} \
        --jobs {{ quote(jobs) }} --threads 1

amptools-build:
    mkdir -p {{ quote(timings) }}
    if ! {{ quote(here / "run-amptools-reference") }} build \
      > {{ quote(timings / "amptools-build.log") }} 2>&1; then \
      cat {{ quote(timings / "amptools-build.log") }} >&2; \
      exit 1; \
    fi

# Build, evaluate, and validate the deterministic AmpTools reference.
amptools-reference:
    {{ quote(here / "run-amptools-reference") }} run

amptools-configs: translate
    cd {{ quote(here) }} && {{ quote(python) }} prepare.py amptools \
      --directory {{ quote(generated / "amptools") }}

# Fit each ROOT mass bin with AmpTools' Zlm amplitude.
amptools: amptools-build amptools-configs
    GENERATED={{ quote(generated / "amptools") }} FIT_ZLM={{ quote(here / "fitZlm") }} \
      {{ quote(python) }} {{ quote(here / "benchmark.py") }} run \
        --name AmpTools \
        --output {{ quote(timings / "amptools.json") }} \
        --log {{ quote(timings / "amptools.log") }} -- \
        bash -c 'printf '\''%s\0'\'' "$GENERATED"/*.cfg | xargs -0 -n1 -P {{ quote(jobs) }} bash -c '\''cd "$GENERATED" && "$FIT_ZLM" "$1"'\'' _'

pawian-build:
    mkdir -p {{ quote(timings) }}
    if ! {{ quote(repo / "Scripts/run-pawian-build") }} \
      b2 -j{{ quote(jobs) }} variant=release gammap-install \
      > {{ quote(timings / "pawian-build.log") }} 2>&1; then \
      cat {{ quote(timings / "pawian-build.log") }} >&2; \
      exit 1; \
    fi

pawian-configs: translate pawian-build
    mkdir -p {{ quote(generated / "pawian") }} {{ quote(timings) }}
    if ! (cd {{ quote(generated / "pawian") }} && {{ quote(repo / "bin/gammapReactionApp") }} \
      -c {{ quote(here / "pawian.cfg") }} --mode dumpDefaultParams --name _zlm) \
      > {{ quote(timings / "pawian-config.log") }} 2>&1; then \
      cat {{ quote(timings / "pawian-config.log") }} >&2; \
      exit 1; \
    fi
    cd {{ quote(here) }} && {{ quote(python) }} prepare.py pawian \
      --defaults {{ quote(generated / "pawian/defaultparams_zlm.dat") }} \
      --directory {{ quote(generated / "pawian") }}

# Fit each ASCII mass bin with PAWIAN's Reflectivity production formalism.
pawian: pawian-configs
    GENERATED={{ quote(generated / "pawian") }} PAWIAN_APP={{ quote(repo / "bin/gammapReactionApp") }} \
      {{ quote(python) }} {{ quote(here / "benchmark.py") }} run \
        --name PAWIAN \
        --output {{ quote(timings / "pawian.json") }} \
        --log {{ quote(timings / "pawian.log") }} -- \
        bash -c 'printf '\''%s\0'\'' "$GENERATED"/*.cfg | xargs -0 -n1 -P {{ quote(jobs) }} bash -c '\''cfg="$1"; name=$(basename "$cfg" .cfg); cd "$GENERATED/$name" && "$PAWIAN_APP" -c "$cfg" --mode pwa --name "_$name"'\'' _'

all: laddu amptools pawian

# Plot fitted D/S parameters and mass-binned S0+/D2+ projections.
plots: all
    cd {{ quote(here) }} && {{ quote(python) }} plot_compare.py \
      --directory {{ quote(generated) }} \
      --output {{ quote(generated / "fit-comparison.png") }}
    {{ quote(python) }} {{ quote(here / "benchmark.py") }} report \
      {{ quote(timings / "laddu.json") }} \
      {{ quote(timings / "amptools.json") }} \
      {{ quote(timings / "pawian.json") }}
