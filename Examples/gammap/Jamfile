alias install : install-bin install-lib ;
explicit install ;

install install-bin : gammapReactionApp selectGammapDataApp
                 : <location>$(TOP)/bin
                   <install-dependencies>on 
                   <install-type>EXE
                   ;

install install-lib : gammap
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project : 
        ;

lib gammap : 
        [ glob *.cc : *App.cc ]  
        $(TOP)/qft++//qft++ 
        $(TOP)/ErrLogger//ErrLogger
        $(TOP)/ConfigParser//ConfigParser
	$(TOP)/FitParams//FitParams
        $(TOP)/PwaUtils//PwaUtils
	$(TOP)/MinFunctions//MinFunctions
	$(TOP)/AppUtils//AppUtils
        $(TOP)/gammapUtils//gammapUtils
        $(TOP)/Particle//Particle
        $(TOP)/Event//Event
        :  
        : 
        :   ;

exe gammapReactionApp : gammapReactionApp.cc gammap
        $(TOP)/gammapUtils//gammapUtils
        $(TOP)/AppUtils//AppUtils
        $(TOP)/MinFunctions//MinFunctions
        $(TOP)/PwaUtils//PwaUtils
        $(TOP)/FitParams//FitParams
        $(TOP)/Event//Event
        $(TOP)/Particle//Particle
        $(TOP)/Utils//Utils
        $(TOP)/ErrLogger//ErrLogger
        $(TOP)/qft++//qft++
        : ;
exe selectGammapDataApp : selectGammapDataApp.cc gammap
        $(TOP)/Event//Event
        $(TOP)/Utils//Utils
        $(TOP)/ErrLogger//ErrLogger
        $(TOP)/qft++//qft++
        : ;
