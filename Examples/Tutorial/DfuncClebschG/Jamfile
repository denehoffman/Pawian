alias install : install-bin install-lib ;
explicit install ;

install install-bin : ClebschGApp JPCdecaysApp DfuncApp HeliTrafoApp
                 : <location>$(TOP)/bin
                   <install-dependencies>on 
                   <install-type>EXE
                   ;

install install-lib : DfuncClebschG
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project : 
        ;

lib DfuncClebschG : 
        [ glob *.cc : *App.cc ]  
        $(TOP)/qft++//qft++ 
        $(TOP)/ErrLogger//ErrLogger
	$(TOP)/qft++Extension//qft++Extension
	$(TOP)/PwaUtils//PwaUtils
	: 
	: 
	: ;

exe ClebschGApp : ClebschGApp.cc DfuncClebschG : ;
exe JPCdecaysApp : JPCdecaysApp.cc DfuncClebschG : ;
exe DfuncApp : DfuncApp.cc DfuncClebschG : ;
exe HeliTrafoApp : HeliTrafoApp.cc DfuncClebschG : ;