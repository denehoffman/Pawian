alias install : install-bin install-lib ;
explicit install ;

install install-bin : TensorApp
                 : <location>$(TOP)/bin
                   <install-dependencies>on 
                   <install-type>EXE
                   ;

install install-lib : qft++Exams
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project : 
        ;

lib qft++Exams : 
        [ glob *.cc : *App.cc ]  
        $(TOP)/qft++//qft++ 
        $(TOP)/ErrLogger//ErrLogger
	:  
	: 
	:   ;

exe TensorApp : TensorApp.cc qft++Exams : ;
