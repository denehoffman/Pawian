alias install : install-bin install-lib ;
explicit install ;

install install-bin : MinuitFitApp
                 : <location>$(TOP)/bin
                   <install-dependencies>on 
                   <install-type>EXE
                   ;

install install-lib : MinuitFit
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project : 
        ;

lib MinuitFit : 
        [ glob *.cc : *App.cc ]  
        $(TOP)/qft++//qft++ 
        $(TOP)/ErrLogger//ErrLogger
	: <use>$(TOP)//Minuit2 
	: 
	: <library>$(TOP)//Minuit2 ;

exe MinuitFitApp : MinuitFitApp.cc MinuitFit 
        	   $(TOP)/qft++//qft++ 
       		   $(TOP)/ErrLogger//ErrLogger
    		 : ;

