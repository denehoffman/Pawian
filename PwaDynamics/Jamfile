alias install : install-lib ;
explicit install ;

install install-lib : PwaDynamics
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project : 
	;

lib PwaDynamics : 
	[ glob *.cc : *App.cc ] 
	$(TOP)/Utils//Utils
	$(TOP)/Particle//Particle 
	$(TOP)/qft++//qft++
	$(TOP)/ErrLogger//ErrLogger
	: 
	: 
	:  ;
