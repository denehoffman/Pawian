alias install : install-bin install-lib ;
explicit install ;

install install-bin : BBUnstableParFitApp LUTFileApp
                 : <location>$(TOP)/bin
                   <install-dependencies>on 
                   <install-type>EXE
                   ;


install install-lib : PwaDynamics
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project : 
	;

lib PwaDynamics : 
	[ glob *.cc : *App.cc ] 
	$(TOP)/Utils//Utils
	$(TOP)/Particle//Particle 
	$(TOP)/qft++//qft++
	$(TOP)/qft++Extension//qft++Extension
	$(TOP)/ErrLogger//ErrLogger
	: <use>$(TOP)//Minuit2 
        : 
        : <library>$(TOP)//Minuit2 ;

exe BBUnstableParFitApp : BBUnstableParFitApp.cc PwaDynamics 	
        $(TOP)/Utils//Utils
	$(TOP)/Particle//Particle 
	$(TOP)/qft++//qft++
	$(TOP)/qft++Extension//qft++Extension
	$(TOP)/ErrLogger//ErrLogger
        : ;

exe LUTFileApp : LUTFileApp.cc PwaDynamics 	
        $(TOP)/Utils//Utils
	$(TOP)/Particle//Particle 
	$(TOP)/qft++//qft++
	$(TOP)/qft++Extension//qft++Extension
	$(TOP)/ErrLogger//ErrLogger
        : ;
