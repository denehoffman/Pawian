alias install : install-lib ;
explicit install ;

install install-lib : PwaUtils
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;
project : 
	;

lib PwaUtils : 
	[ glob *.cc : *App.cc ] 
	$(TOP)/Utils//Utils 
	$(TOP)/qft++//qft++
	$(TOP)/qft++Extension//qft++Extension
	$(TOP)/ErrLogger//ErrLogger
	$(TOP)/Event//Event
	$(TOP)/FitParams//FitParams
	$(TOP)/ConfigParser//ConfigParser
	$(TOP)/PwaDynamics//PwaDynamics
	$(TOP)/PspGen//PspGen
	:
	: 
	: <library>$(TOP)/qft++Extension//qft++Extension
	  <library>$(TOP)/ConfigParser//ConfigParser
	;
