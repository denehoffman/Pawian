alias install : install-bin install-lib ;
explicit install ;

install install-bin : ErrLoggerTestApp Log4CppTestApp
                 : <location>$(TOP)/bin
                   <install-dependencies>on 
                   <install-type>EXE
                   ;

install install-lib : ErrLogger
                 : <location>$(TOP)/lib 
                   <install-dependencies>on 
                   <install-type>LIB
                   ;

project : 
	requirements
	<linkflags>-llog4cpp
	;

lib ErrLogger : [ glob *.cc : *App.cc ] : : : ;

exe ErrLoggerTestApp : ErrLoggerTestApp.cc ErrLogger : ;
exe Log4CppTestApp : Log4CppTestApp.cc ErrLogger : ;
